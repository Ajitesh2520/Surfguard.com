{
  "manifest_version": 3,
  "name": "SurfGuard",
  "version": "0.1.0",
  "description": "AI-powered browser focus agent",
  "permissions": ["tabs", "storage"],
  "host_permissions": [
    "http://localhost:4000/*",
    "http://localhost:4001/*",
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "SurfGuard"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
